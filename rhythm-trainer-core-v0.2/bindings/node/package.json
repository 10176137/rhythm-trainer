{
  "name": "@rhythm-trainer/native",
  "version": "0.5.0",
  "private": true,
  "description": "Node-API binding for Rhythm Trainer Rust core",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --platform --release --js false",
    "build:debug": "napi build --js false",
    "test:core": "cargo test --manifest-path ../../Cargo.toml"
  },
  "napi": {
    "name": "rhythm_trainer_native",
    "triples": {
      "defaults": true
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}
